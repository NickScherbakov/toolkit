// Модуль формы Консоли кода
// Выполнение произвольного BSL-кода на клиенте и сервере

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.РедакторКода.УстановитьТекст(ПолучитьМакетМонакоHTML());
	ОбновитьЗаголовокФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура РедакторКодаПриНавигации(Элемент, НавигационнаяСсылка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если НачалоСтроки(НавигационнаяСсылка, "toolkit://code?") Тогда
		ТекстКода = СтрЗаменить(Сред(НавигационнаяСсылка, СтрДлина("toolkit://code?") + 1), "+", " ");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ВыполнитьНаКлиенте(Команда)
	
	Если ПустаяСтрока(ТекстКода) Тогда
		ПоказатьПредупреждение(, "Введите код для выполнения.");
		Возврат;
	КонецЕсли;
	
	СтрокаСтатуса = "Выполняется на клиенте...";
	Попытка
		Выполнить(ТекстКода);
		СтрокаСтатуса = "Выполнено на клиенте успешно.";
		ДобавитьВИсторию(ТекстКода, "Клиент", "OK");
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		СтрокаСтатуса = "Ошибка: " + ТекстОшибки;
		ДобавитьВИсторию(ТекстКода, "Клиент", "Ошибка: " + ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьНаСервере(Команда)
	
	Если ПустаяСтрока(ТекстКода) Тогда
		ПоказатьПредупреждение(, "Введите код для выполнения.");
		Возврат;
	КонецЕсли;
	
	СтрокаСтатуса = "Выполняется на сервере...";
	ТекстРезультата = "";
	Попытка
		ВыполнитьКодНаСервере(ТекстКода, ТекстРезультата);
		СтрокаСтатуса = "Выполнено на сервере успешно.";
		ДобавитьВИсторию(ТекстКода, "Сервер", "OK");
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		СтрокаСтатуса = "Ошибка: " + ТекстОшибки;
		ДобавитьВИсторию(ТекстКода, "Сервер", "Ошибка: " + ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	
	ТекстКода = "";
	ТекстРезультата = "";
	СтрокаСтатуса = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьИсторию(Команда)
	
	ИсторияВыполнения.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьКодНаСервере(Код, Результат)
	
	// Выполнение кода на стороне сервера
	// Используем Выполнить() для выполнения произвольного BSL-кода
	Выполнить(Код);
	
	// Результат выполнения — строковое представление последнего значения переменной "Результат"
	// если пользователь в коде присваивает: Результат = ...
	Результат = ?(Результат = Неопределено, "<нет результата>", Строка(Результат));
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВИсторию(Код, Контекст, Статус)
	
	НоваяСтрока = ИсторияВыполнения.Добавить();
	НоваяСтрока.Время = ТекущаяДата();
	НоваяСтрока.Контекст = Контекст;
	НоваяСтрока.Статус = Статус;
	НоваяСтрока.Код = Лев(Код, 200);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗаголовокФормы()
	
	Заголовок = "Консоль кода — 1C Developer Toolkit";
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьМакетМонакоHTML()
	
	HTML = "<!DOCTYPE html>
	|<html><head><meta charset='utf-8'>
	|<style>html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden}
	|#container{width:100%;height:100%}</style></head>
	|<body><div id='container'></div>
	|<script src='https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/loader.min.js'></script>
	|<script>
	|require.config({paths:{'vs':'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs'}});
	|require(['vs/editor/editor.main'],function(){
	|  window.editor=monaco.editor.create(document.getElementById('container'),{
	|    value:'// Код 1С\n',language:'plaintext',theme:'vs',automaticLayout:true,
	|    fontSize:13,minimap:{enabled:false}
	|  });
	|  function sync(){window.location.href='toolkit://code?'+encodeURIComponent(window.editor.getValue());}
	|  window.editor.onDidChangeModelContent(sync);
	|});
	|function setCode(t){if(window.editor)window.editor.setValue(t);}
	|</script></body></html>";
	
	Возврат HTML;
	
КонецФункции

#КонецОбласти
