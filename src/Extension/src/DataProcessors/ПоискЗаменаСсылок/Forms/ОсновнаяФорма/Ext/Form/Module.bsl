// Модуль формы Поиска и замены ссылок

#Область КомандыФормы

&НаКлиенте
Процедура Найти(Команда)
	Если НЕ ЗначениеЗаполнено(ИсходнаяСсылка) Тогда
		ПоказатьПредупреждение(, "Укажите ссылку для поиска.");
		Возврат;
	КонецЕсли;
	НайтиСсылкиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьВсе(Команда)
	Если НЕ ЗначениеЗаполнено(ИсходнаяСсылка) Тогда
		ПоказатьПредупреждение(, "Укажите исходную ссылку.");
		Возврат;
	КонецЕсли;
	ВопросОЗамене = Новый ОписаниеОповещения("ВопросОЗаменеЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ВопросОЗамене,
		"Заменить все найденные ссылки (" + РезультатыПоиска.Количество() + " мест)?",
		РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ВопросОЗаменеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаменитьСсылкиНаСервере();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура НайтиСсылкиНаСервере()
	РезультатыПоиска.Очистить();
	НайденныеМеста = НайтиПоСсылкам(ОбъединитьМассивы(ИсходнаяСсылка));
	Для Каждого МестоИспользования Из НайденныеМеста Цикл
		НоваяСтрока = РезультатыПоиска.Добавить();
		НоваяСтрока.Объект  = МестоИспользования.Ссылка;
		НоваяСтрока.Реквизит = МестоИспользования.Метаданные.Имя;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаменитьСсылкиНаСервере()
	ЗаменитьСсылки(ИсходнаяСсылка, НоваяСсылка);
	НайтиСсылкиНаСервере();
КонецПроцедуры

&НаСервере
Функция ОбъединитьМассивы(Значение)
	М = Новый Массив;
	М.Добавить(Значение);
	Возврат М;
КонецФункции
