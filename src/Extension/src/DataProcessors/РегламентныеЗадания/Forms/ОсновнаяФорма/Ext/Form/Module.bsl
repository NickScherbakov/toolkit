// Модуль формы Регламентных и фоновых заданий

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьСписокЗаданий();
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьСписокЗаданий();
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьЗадание(Команда)
	ТекущаяСтрока = Элементы.ТаблицаЗаданий.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда Возврат; КонецЕсли;
	Попытка
		ЗапуститьЗаданиеНаСервере(ТекущаяСтрока.УникальныйИдентификатор);
		ОбновитьСписокЗаданий();
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ОбновитьСписокЗаданий()
	ТаблицаЗаданий.Очистить();
	Все = РегламентныеЗадания.ПолучитьРегламентныеЗадания();
	Для Каждого РЗ Из Все Цикл
		НоваяСтрока = ТаблицаЗаданий.Добавить();
		НоваяСтрока.Имя                   = РЗ.Имя;
		НоваяСтрока.Наименование          = РЗ.Наименование;
		НоваяСтрока.Использование         = РЗ.Использование;
		НоваяСтрока.ПоследнееЗапланированное = РЗ.ПредопределенноеРегламентноеЗадание;
		НоваяСтрока.УникальныйИдентификатор = РЗ.УникальныйИдентификатор;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗапуститьЗаданиеНаСервере(УИДЗ)
	РЗ = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(УИДЗ);
	Если РЗ = Неопределено Тогда
		ВызватьИсключение "Регламентное задание не найдено.";
	КонецЕсли;
	ФоновоеЗадание = ФоновыеЗадания.Выполнить(РЗ.ИмяМетода, Новый Массив, , РЗ.Наименование);
КонецПроцедуры
