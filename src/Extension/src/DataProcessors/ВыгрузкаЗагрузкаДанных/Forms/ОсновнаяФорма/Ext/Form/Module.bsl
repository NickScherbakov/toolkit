// Модуль формы Выгрузки/Загрузки данных

#Область КомандыФормы

&НаКлиенте
Процедура Выгрузить(Команда)
	Если НЕ ЗначениеЗаполнено(СсылкиДляВыгрузки) Тогда
		ПоказатьПредупреждение(, "Добавьте объекты для выгрузки.");
		Возврат;
	КонецЕсли;
	
	ДиалогСохранения = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогСохранения.Фильтр = "XML файлы (*.xml)|*.xml";
	ДиалогСохранения.ПоказатьДиалог(Новый ОписаниеОповещения("ВыборФайлаВыгрузкиЗавершение", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаВыгрузкиЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы = Неопределено Тогда Возврат; КонецЕсли;
	ПутьФайла = ВыбранныеФайлы[0];
	Попытка
		ВыгрузитьДанныеНаСервере(ПутьФайла);
		ПоказатьОповещениеПользователя("Выгрузка завершена", , "Файл: " + ПутьФайла);
	Исключение
		ПоказатьПредупреждение(, "Ошибка выгрузки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	ДиалогОткрытия = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогОткрытия.Фильтр = "XML файлы (*.xml)|*.xml";
	ДиалогОткрытия.ПоказатьДиалог(Новый ОписаниеОповещения("ВыборФайлаЗагрузкиЗавершение", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаЗагрузкиЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы = Неопределено Тогда Возврат; КонецЕсли;
	ПутьФайла = ВыбранныеФайлы[0];
	Попытка
		ЗагрузитьДанныеНаСервере(ПутьФайла);
		ПоказатьОповещениеПользователя("Загрузка завершена", , "Файл: " + ПутьФайла);
	Исключение
		ПоказатьПредупреждение(, "Ошибка загрузки: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ВыгрузитьДанныеНаСервере(ПутьФайла)
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ПутьФайла);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписьXML.ЗаписатьНачалоЭлемента("Выгрузка");
	ЗаписьXML.ЗаписатьАтрибут("ДатаВремя", XMLСтрока(ТекущаяДата()));
	
	Для Каждого СсылкаДляВыгрузки Из СсылкиДляВыгрузки Цикл
		СериализаторXDTO = Новый СериализаторXDTO(ФабрикаXDTO.СоздатьФабрику(Новый Файл("")));
		ЗаписатьXML(ЗаписьXML, СсылкаДляВыгрузки, НазначениеТипаXML.Явное);
	КонецЦикла;
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.Закрыть();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеНаСервере(ПутьФайла)
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПутьФайла);
	
	// Пропустить заголовок и корневой элемент <Выгрузка>
	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ЧтениеXML.ЛокальноеИмя <> "Выгрузка" Тогда
			Попытка
				// Десериализовать объект через стандартный механизм 1С
				Объект = ПрочитатьXML(ЧтениеXML);
				Если ТипЗнч(Объект) = Тип("Строка") ИЛИ Объект = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Объект.Записать();
			Исключение
				// Пропустить объекты, которые не удалось загрузить
				Продолжить;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	ЧтениеXML.Закрыть();
КонецПроцедуры
