// Модуль формы Монитора лицензий

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьДанные();
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьДанные();
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ОбновитьДанные()
	ТаблицаСеансов.Очистить();
	
	// Получить активные сеансы
	СеансыИБ = ПолучитьСеансыИнформационнойБазы();
	Для Каждого Сеанс Из СеансыИБ Цикл
		НоваяСтрока = ТаблицаСеансов.Добавить();
		НоваяСтрока.НомерСеанса         = Сеанс.НомерСеанса;
		НоваяСтрока.Пользователь        = Сеанс.ИмяПользователя;
		НоваяСтрока.Приложение          = Сеанс.Приложение;
		НоваяСтрока.Компьютер           = Сеанс.Компьютер;
		НоваяСтрока.НачалоСеанса        = Сеанс.НачалоСеанса;
		НоваяСтрока.ТипЛицензии         = "Клиентская";
	КонецЦикла;
	
	ИтогоСеансов = ТаблицаСеансов.Количество();
КонецПроцедуры
