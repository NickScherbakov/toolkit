// Модуль формы Консоли запросов

// HTML-шаблон для Monaco Editor (редактор запросов 1С)
Перем МонакоHTML;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	МонакоHTML = ПолучитьМакетМонакоHTML();
	Элементы.РедакторЗапроса.УстановитьТекст(МонакоHTML);
	
КонецПроцедуры

&НаКлиенте
Процедура РедакторЗапросаПриНавигации(Элемент, НавигационнаяСсылка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НачалоСтроки(НавигационнаяСсылка, "toolkit://text?") Тогда
		ТекстЗапроса = URLDecodeText(Сред(НавигационнаяСсылка, СтрДлина("toolkit://text?") + 1));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура Выполнить(Команда)
	
	ВыполнитьЗапрос();
	
КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	
	ТекстЗапроса = "";
	РезультатТаблица.Очистить();
	СтрокаСтатуса = "";
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьПараметры(Команда)
	
	ПоказатьПредупреждение(, "Редактирование параметров: используйте таблицу 'Параметры запроса' на форме.");
	
КонецПроцедуры

&НаКлиенте
Процедура КонструкторЗапроса(Команда)
	
	ОткрытьКонструкторЗапроса(Новый ОписаниеОповещения("КонструкторЗапросаЗавершение", ЭтотОбъект), ТекстЗапроса);
	
КонецПроцедуры

&НаКлиенте
Процедура КонструкторЗапросаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ТекстЗапроса = Результат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыполнитьЗапрос()
	
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		ПоказатьПредупреждение(, "Введите текст запроса.");
		Возврат;
	КонецЕсли;
	
	СтрокаСтатуса = "Выполняется...";
	
	Попытка
		ВыполнитьЗапросНаСервере();
		СтрокаСтатуса = "Выполнено успешно. Строк: " + РезультатТаблица.Количество();
	Исключение
		СтрокаСтатуса = "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗапросНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Для Каждого СтрокаПараметра Из ПараметрыЗапроса Цикл
		Если НЕ ПустаяСтрока(СтрокаПараметра.Имя) Тогда
			Запрос.УстановитьПараметр(СтрокаПараметра.Имя, СтрокаПараметра.Значение);
		КонецЕсли;
	КонецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();
	
	// Сформировать колонки таблицы формы
	Элементы.ТаблицаРезультата.Колонки.Очистить();
	Для Каждого Колонка Из ТаблицаРезультата.Колонки Цикл
		НоваяКолонка = Элементы.Добавить(
			"Кол_" + Колонка.Имя,
			Тип("ЭлементФормыПолеТаблицы"),
			Элементы.ТаблицаРезультата);
		НоваяКолонка.ПутьКДанным = "РезультатТаблица." + Колонка.Имя;
		НоваяКолонка.Заголовок = Колонка.Имя;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ТаблицаРезультата, "РезультатТаблица");
	ТекстЗапросаПросмотр = ТекстЗапроса;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьМакетМонакоHTML()
	
	HTML = "<!DOCTYPE html>
	|<html><head><meta charset='utf-8'>
	|<style>html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden}
	|#container{width:100%;height:100%}</style></head>
	|<body><div id='container'></div>
	|<script src='https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/loader.min.js'></script>
	|<script>
	|require.config({paths:{'vs':'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs'}});
	|require(['vs/editor/editor.main'],function(){
	|  window.editor=monaco.editor.create(document.getElementById('container'),{
	|    value:'',language:'sql',theme:'vs',automaticLayout:true,fontSize:13,
	|    minimap:{enabled:false}
	|  });
	|  function sync(){window.location.href='toolkit://text?'+encodeURIComponent(window.editor.getValue());}
	|  window.editor.onDidChangeModelContent(sync);
	|  window.editor.addCommand(monaco.KeyCode.F5,sync);
	|});
	|function setQueryText(t){if(window.editor)window.editor.setValue(t);}
	|</script></body></html>";
	
	Возврат HTML;
	
КонецФункции

// Декодирует URL-кодированную строку (application/x-www-form-urlencoded).
// Обрабатывает как замену + на пробел, так и %XX последовательности.
&НаКлиенте
Функция URLDecodeText(КодированнаяСтрока)
	
	// Сначала заменяем + на пробел (application/x-www-form-urlencoded)
	Результат = СтрЗаменить(КодированнаяСтрока, "+", " ");
	
	// Декодируем %XX последовательности
	// Собираем байты подряд для корректного декодирования многобайтных символов (UTF-8)
	Позиция = 1;
	ДлинаСтроки = СтрДлина(Результат);
	ВыходнаяСтрока = "";
	
	Пока Позиция <= ДлинаСтроки Цикл
		Символ = Сред(Результат, Позиция, 1);
		Если Символ = "%" И Позиция + 2 <= ДлинаСтроки Тогда
			// Собираем подряд идущие %XX байты для UTF-8 декодирования
			МассивБайт = Новый Массив;
			Пока Символ = "%" И Позиция + 2 <= ДлинаСтроки Цикл
				ШестнадцатеричныйКод = Сред(Результат, Позиция + 1, 2);
				МассивБайт.Добавить(НРег(ШестнадцатеричныйКод));
				Позиция = Позиция + 3;
				Если Позиция <= ДлинаСтроки Тогда
					Символ = Сред(Результат, Позиция, 1);
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			// Конвертируем байты UTF-8 в строку 1С через буфер
			БуферБайт = Новый БуферДвоичныхДанных(МассивБайт.Количество());
			Для Индекс = 0 По МассивБайт.Количество() - 1 Цикл
				БуферБайт.Записать(Индекс, НРег(МассивБайт[Индекс]));
			КонецЦикла;
			ДД = БуферБайт.ПолучитьДвоичныеДанные();
			ВыходнаяСтрока = ВыходнаяСтрока + ПолучитьСтрокуИзДвоичныхДанных(ДД, "UTF-8");
		Иначе
			ВыходнаяСтрока = ВыходнаяСтрока + Символ;
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВыходнаяСтрока;
	
КонецФункции

#КонецОбласти
