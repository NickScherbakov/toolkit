// Модуль формы "Все функции"
// Расширенный навигатор объектов конфигурации

#Область КомандыФормы

&НаКлиенте
Процедура Найти(Команда)
	Если НЕ ПустаяСтрока(ТекстПоиска) Тогда
		НайтиОбъектыНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВыбранный(Команда)
	ТекущаяСтрока = Элементы.РезультатыПоиска.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоказатьЗначение(, ТекущаяСтрока.Ссылка);
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура НайтиОбъектыНаСервере()
	РезультатыПоиска.Очистить();
	ТекстВерхний = ВРег(ТекстПоиска);
	ДобавитьИзКоллекции(Метаданные.Справочники, "Справочник", ТекстВерхний);
	ДобавитьИзКоллекции(Метаданные.Документы,   "Документ",   ТекстВерхний);
	ДобавитьИзКоллекции(Метаданные.Отчеты,      "Отчёт",      ТекстВерхний);
	ДобавитьИзКоллекции(Метаданные.Обработки,   "Обработка",  ТекстВерхний);
КонецПроцедуры

&НаСервере
Процедура ДобавитьИзКоллекции(Коллекция, ТипОбъекта, ТекстВерхний)
	Для Каждого ОбъектМД Из Коллекция Цикл
		Если СтрНайти(ВРег(ОбъектМД.Имя), ТекстВерхний) > 0
			ИЛИ СтрНайти(ВРег(ОбъектМД.Синоним), ТекстВерхний) > 0 Тогда
			НоваяСтрока = РезультатыПоиска.Добавить();
			НоваяСтрока.ТипОбъекта = ТипОбъекта;
			НоваяСтрока.Имя        = ОбъектМД.Имя;
			НоваяСтрока.Синоним    = ОбъектМД.Синоним;
			НоваяСтрока.ПолноеИмя  = ОбъектМД.ПолноеИмя();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
