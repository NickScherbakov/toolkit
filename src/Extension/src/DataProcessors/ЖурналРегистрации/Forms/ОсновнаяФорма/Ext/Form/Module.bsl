// Модуль формы Журнала регистрации

#Область КомандыФормы

&НаКлиенте
Процедура Открыть(Команда)
	ПараметрыОтбора = Новый СписокЗначений;
	Если ЗначениеЗаполнено(ОтборПользователь) Тогда
		ПараметрыОтбора.Добавить(ОтборПользователь, "Пользователь");
	КонецЕсли;
	Попытка
		ОткрытьЖурналРегистрации(ПараметрыОтбора);
	Исключение
		ОткрытьЗапросЖурналаНаСервере();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура Прочитать(Команда)
	ПрочитатьЖурналНаСервере();
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПрочитатьЖурналНаСервере()
	СобытияЖурнала.Очистить();
	Отбор = Новый Структура;
	Если НЕ ПустаяСтрока(ОтборПользователь) Тогда
		Отбор.Вставить("Пользователь", ОтборПользователь);
	КонецЕсли;
	
	ВыгрузитьЖурналРегистрации(СобытияЖурнала, Отбор, ОтборНачало, ОтборКонец, , 1000);
КонецПроцедуры

&НаСервере
Процедура ОткрытьЗапросЖурналаНаСервере()
	// Резервный вариант — прямое чтение журнала через ВыгрузитьЖурналРегистрации
	ПрочитатьЖурналНаСервере();
КонецПроцедуры
