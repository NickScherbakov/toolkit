// Модуль формы Менеджера формы

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Анализируем текущий контекст — можно передать форму через параметры
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура АнализироватьФорму(Команда)
	Если НЕ ЗначениеЗаполнено(ИмяФормы) Тогда
		ПоказатьПредупреждение(, "Укажите полное имя формы.");
		Возврат;
	КонецЕсли;
	АнализироватьФормуКлиент();
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура АнализироватьФормуКлиент()
	// ПолучитьФорму() работает только на клиенте
	ЭлементыФормы.Очистить();
	
	Попытка
		Форма = ПолучитьФорму(ИмяФормы, , , Ложь, Ложь, Ложь);
		
		ЗагрузитьЭлементыФормыНаСервере(Форма.Элементы);
		
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПоказатьПредупреждение(, "Ошибка анализа формы: " + ТекстОшибки);
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЭлементыФормыНаСервере(КоллекцияЭлементов)
	ЭлементыФормы.Очистить();
	
	Для Каждого Элемент Из КоллекцияЭлементов Цикл
		НоваяСтрока = ЭлементыФормы.Добавить();
		НоваяСтрока.Имя    = Элемент.Имя;
		НоваяСтрока.Тип    = "" + ТипЗнч(Элемент);
	КонецЦикла;
КонецПроцедуры
