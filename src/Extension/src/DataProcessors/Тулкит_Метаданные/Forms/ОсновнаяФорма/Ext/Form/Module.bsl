// Модуль формы просмотра Метаданных
// Дерево конфигурации, поиск, структура хранения

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗагрузитьДеревоМетаданных();
	
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура Обновить(Команда)
	
	ДеревоМетаданных.Строки.Очистить();
	ЗагрузитьДеревоМетаданных();
	
КонецПроцедуры

&НаКлиенте
Процедура Найти(Команда)
	
	Если ПустаяСтрока(ТекстПоиска) Тогда
		ПоказатьПредупреждение(, "Введите текст для поиска.");
		Возврат;
	КонецЕсли;
	
	НайтиВМетаданных();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСтруктуруХранения(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоМетаданных.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено ИЛИ ПустаяСтрока(ТекущаяСтрока.ПолноеИмя) Тогда
		ПоказатьПредупреждение(, "Выберите объект метаданных.");
		Возврат;
	КонецЕсли;
	
	ПоказатьСтруктуруХраненияНаСервере(ТекущаяСтрока.ПолноеИмя);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьДеревоМетаданных()
	
	ДобавитьРазделМетаданных("Справочники", Метаданные.Справочники, "ЗначениеРеквизита");
	ДобавитьРазделМетаданных("Документы", Метаданные.Документы, "ЗначениеРеквизита");
	ДобавитьРазделМетаданных("Регистры сведений", Метаданные.РегистрыСведений, "ЗначениеРеквизита");
	ДобавитьРазделМетаданных("Регистры накопления", Метаданные.РегистрыНакопления, "ЗначениеРеквизита");
	ДобавитьРазделМетаданных("Регистры бухгалтерии", Метаданные.РегистрыБухгалтерии, "ЗначениеРеквизита");
	ДобавитьРазделМетаданных("Отчёты", Метаданные.Отчеты, "ЗначениеРеквизита");
	ДобавитьРазделМетаданных("Обработки", Метаданные.Обработки, "ЗначениеРеквизита");
	ДобавитьРазделМетаданных("Перечисления", Метаданные.Перечисления, "ЗначениеРеквизита");
	ДобавитьРазделМетаданных("Планы видов характеристик", Метаданные.ПланыВидовХарактеристик, "ЗначениеРеквизита");
	ДобавитьРазделМетаданных("Планы счетов", Метаданные.ПланыСчетов, "ЗначениеРеквизита");
	ДобавитьРазделМетаданных("Бизнес-процессы", Метаданные.БизнесПроцессы, "ЗначениеРеквизита");
	ДобавитьРазделМетаданных("Задачи", Метаданные.Задачи, "ЗначениеРеквизита");
	ДобавитьРазделМетаданных("Общие модули", Метаданные.ОбщиеМодули, "ЗначениеРеквизита");
	ДобавитьРазделМетаданных("Константы", Метаданные.Константы, "ЗначениеРеквизита");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРазделМетаданных(Название, КоллекцияМетаданных, ЗначениеРеквизита)
	
	КорневаяСтрока = ДеревоМетаданных.Строки.Добавить();
	КорневаяСтрока.Имя = Название;
	КорневаяСтрока.Синоним = Название;
	КорневаяСтрока.ПолноеИмя = "";
	КорневаяСтрока.КоличествоОбъектов = КоллекцияМетаданных.Количество();
	
	Для Каждого ОбъектМД Из КоллекцияМетаданных Цикл
		ДочерняяСтрока = КорневаяСтрока.Строки.Добавить();
		ДочерняяСтрока.Имя = ОбъектМД.Имя;
		ДочерняяСтрока.Синоним = ОбъектМД.Синоним;
		ДочерняяСтрока.ПолноеИмя = ОбъектМД.ПолноеИмя();
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НайтиВМетаданных()
	
	РезультатыПоиска.Очистить();
	ТекстПоискаВерхний = ВРег(ТекстПоиска);
	
	// Поиск по всем основным коллекциям метаданных
	ДобавитьНайденныеОбъекты(Метаданные.Справочники,             ТекстПоискаВерхний);
	ДобавитьНайденныеОбъекты(Метаданные.Документы,               ТекстПоискаВерхний);
	ДобавитьНайденныеОбъекты(Метаданные.РегистрыСведений,        ТекстПоискаВерхний);
	ДобавитьНайденныеОбъекты(Метаданные.РегистрыНакопления,      ТекстПоискаВерхний);
	ДобавитьНайденныеОбъекты(Метаданные.РегистрыБухгалтерии,     ТекстПоискаВерхний);
	ДобавитьНайденныеОбъекты(Метаданные.Отчеты,                  ТекстПоискаВерхний);
	ДобавитьНайденныеОбъекты(Метаданные.Обработки,               ТекстПоискаВерхний);
	ДобавитьНайденныеОбъекты(Метаданные.Перечисления,            ТекстПоискаВерхний);
	ДобавитьНайденныеОбъекты(Метаданные.ПланыВидовХарактеристик, ТекстПоискаВерхний);
	ДобавитьНайденныеОбъекты(Метаданные.ПланыСчетов,             ТекстПоискаВерхний);
	ДобавитьНайденныеОбъекты(Метаданные.БизнесПроцессы,          ТекстПоискаВерхний);
	ДобавитьНайденныеОбъекты(Метаданные.Задачи,                  ТекстПоискаВерхний);
	ДобавитьНайденныеОбъекты(Метаданные.ОбщиеМодули,             ТекстПоискаВерхний);
	ДобавитьНайденныеОбъекты(Метаданные.Константы,               ТекстПоискаВерхний);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьНайденныеОбъекты(Коллекция, ТекстПоискаВерхний)
	
	Для Каждого ОбъектМД Из Коллекция Цикл
		Если СтрНайти(ВРег(ОбъектМД.Имя), ТекстПоискаВерхний) > 0
			ИЛИ СтрНайти(ВРег(ОбъектМД.Синоним), ТекстПоискаВерхний) > 0 Тогда
			НоваяСтрока = РезультатыПоиска.Добавить();
			НоваяСтрока.ПолноеИмя = ОбъектМД.ПолноеИмя();
			НоваяСтрока.Синоним = ОбъектМД.Синоним;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьСтруктуруХраненияНаСервере(ПолноеИмяОбъекта)
	
	СтруктураХранения.Очистить();
	
	МД = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	Если МД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Получить структуру хранения через ПолучитьСтруктуруХраненияБазыДанных()
	// Это специализированная операция, требует привилегированного режима
	// или прав на просмотр структуры базы данных
	СтруктПолная = ПолучитьСтруктуруХраненияБазыДанных(МД.ПолноеИмя(), Истина);
	
	Для Каждого Строка Из СтруктПолная Цикл
		НоваяСтрока = СтруктураХранения.Добавить();
		НоваяСтрока.ИмяТаблицы = Строка.ИмяТаблицыХранения;
		НоваяСтрока.Назначение = Строка.Назначение;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
