// Модуль формы Редактора объекта
// Просмотр и редактирование объектов 1С по ссылке

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РежимРедактирования = Ложь;
	ОбновитьДоступностьЭлементов();
	
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура Открыть(Команда)
	
	Если ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		ОткрытьОбъектНаСервере();
		ОбновитьДоступностьЭлементов();
	Иначе
		ПоказатьПредупреждение(, "Укажите ссылку на объект.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	Если НЕ РежимРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	ВопросОСохранении = Новый ОписаниеОповещения("ВопросОСохраненииЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ВопросОСохранении, "Сохранить изменения объекта?", РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросОСохраненииЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Попытка
			СохранитьОбъектНаСервере();
			ПоказатьОповещениеПользователя("Сохранено", , "Объект успешно сохранён.");
		Исключение
			ПоказатьПредупреждение(, "Ошибка сохранения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьРежим(Команда)
	
	РежимРедактирования = НЕ РежимРедактирования;
	ОбновитьДоступностьЭлементов();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОткрытьОбъектНаСервере()
	
	Если СсылкаНаОбъект = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Объект = СсылкаНаОбъект.ПолучитьОбъект();
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	
	// Заполнить таблицу реквизитов
	ТаблицаРеквизитов.Очистить();
	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.Имя = Реквизит.Имя;
		НоваяСтрока.Синоним = Реквизит.Синоним;
		НоваяСтрока.Значение = Объект[Реквизит.Имя];
		НоваяСтрока.ТипЗначения = Строка(Реквизит.Тип);
	КонецЦикла;
	
	// Заполнить список табличных частей
	ИменаТабличныхЧастей.Очистить();
	Для Каждого ТЧ Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		НоваяСтрока = ИменаТабличныхЧастей.Добавить();
		НоваяСтрока.Имя = ТЧ.Имя;
		НоваяСтрока.Синоним = ТЧ.Синоним;
		НоваяСтрока.КоличествоСтрок = Объект[ТЧ.Имя].Количество();
	КонецЦикла;
	
	ИмяОбъекта = Строка(СсылкаНаОбъект);
	ТипОбъекта = ТулкитОбщий.ТипМетаданных(МетаданныеОбъекта);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьОбъектНаСервере()
	
	Объект = СсылкаНаОбъект.ПолучитьОбъект();
	МетаданныеОбъекта = СсылкаНаОбъект.Метаданные();
	
	Для Каждого СтрокаРеквизита Из ТаблицаРеквизитов Цикл
		Реквизит = МетаданныеОбъекта.Реквизиты.Найти(СтрокаРеквизита.Имя);
		Если Реквизит <> Неопределено Тогда
			Объект[СтрокаРеквизита.Имя] = СтрокаРеквизита.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Объект.Записать();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьЭлементов()
	
	Элементы.КнопкаСохранить.Доступность = РежимРедактирования;
	Элементы.ТаблицаРеквизитов.ТолькоПросмотр = НЕ РежимРедактирования;
	КнопкаПереключить = ?(РежимРедактирования, "Режим просмотра", "Режим редактирования");
	
КонецПроцедуры

#КонецОбласти
