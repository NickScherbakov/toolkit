// Модуль формы Глобального меню
// Единая точка входа для всех инструментов Toolkit

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗагрузитьСписокИнструментов();
КонецПроцедуры

&НаКлиенте
Процедура ТекстПоискаПриИзменении(Элемент)
	ФильтроватьИнструменты();
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура ОткрытьВыбранный(Команда)
	ТекущаяСтрока = Элементы.СписокИнструментов.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено И НЕ ПустаяСтрока(ТекущаяСтрока.ИмяОбработки) Тогда
		ТулкитОбщийКлиент.ОткрытьИнструмент(ТекущаяСтрока.ИмяОбработки);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьСписокИнструментов()
	ВсеИнструменты.Очистить();
	ДобавитьИнструмент("КонсольЗапросов", "Консоль запросов", "developer-console", "Редактор и отладчик запросов");
	ДобавитьИнструмент("КонсольКода",    "Консоль кода",     "developer-console", "Выполнение BSL-кода");
	ДобавитьИнструмент("РедакторОбъекта","Редактор объекта", "editor",            "Просмотр и редактирование объектов");
	ДобавитьИнструмент("Метаданные",      "Метаданные",       "analysis",          "Дерево конфигурации");
	ДобавитьИнструмент("ВсеФункции",      "Все функции",      "navigation",        "Навигатор объектов");
	ДобавитьИнструмент("АнализПравДоступа","Анализ прав доступа","analysis",       "Матрица прав: роли × объекты");
	ДобавитьИнструмент("Пользователи",    "Пользователи",     "administration",    "Управление пользователями ИБ");
	ДобавитьИнструмент("РегламентныеЗадания","Регламентные задания","administration","Управление заданиями");
	ДобавитьИнструмент("ЖурналРегистрации","Журнал регистрации","administration",  "Просмотр журнала");
	ДобавитьИнструмент("ПодпискиНаСобытия","Подписки на события","analysis",       "Активные подписки");
	ДобавитьИнструмент("ПоискЗаменаСсылок","Поиск и замена ссылок","analysis",     "Поиск использований объектов");
	ДобавитьИнструмент("СравнениеОбъектов","Сравнение объектов","analysis",        "Сравнение двух объектов");
	ДобавитьИнструмент("МониторЛицензий",  "Монитор лицензий", "administration",   "Активные лицензии");
	ДобавитьИнструмент("КонсольСКД",       "Консоль СКД",      "developer-console","Конструктор схем компоновки");
	ДобавитьИнструмент("МенеджерФормы",    "Менеджер формы",   "analysis",         "Просмотр элементов формы");
	ДобавитьИнструмент("ВыгрузкаЗагрузкаДанных","Выгрузка/Загрузка данных","administration","XML-выгрузка/загрузка");
	ЗначениеВРеквизитФормы(ВсеИнструменты, "СписокИнструментов");
КонецПроцедуры

&НаСервере
Процедура ДобавитьИнструмент(ИмяОбработки, Название, Категория, Описание)
	НоваяСтрока = ВсеИнструменты.Добавить();
	НоваяСтрока.ИмяОбработки = ИмяОбработки;
	НоваяСтрока.Название     = Название;
	НоваяСтрока.Категория    = Категория;
	НоваяСтрока.Описание     = Описание;
КонецПроцедуры

&НаКлиенте
Процедура ФильтроватьИнструменты()
	Если ПустаяСтрока(ТекстПоиска) Тогда
		Элементы.СписокИнструментов.ОтборСтрок = Неопределено;
	Иначе
		ФО = Новый ФиксированнаяСтруктура("Название", ТекстПоиска);
		Элементы.СписокИнструментов.ОтборСтрок = ФО;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
