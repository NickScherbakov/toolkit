// Модуль формы Менеджера формы

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// Анализируем текущий контекст — можно передать форму через параметры
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура АнализироватьФорму(Команда)
	Если НЕ ЗначениеЗаполнено(ИмяФормы) Тогда
		ПоказатьПредупреждение(, "Укажите полное имя формы.");
		Возврат;
	КонецЕсли;
	АнализироватьФормуНаСервере();
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура АнализироватьФормуНаСервере()
	// Открыть форму и получить информацию об её элементах
	// В реальной платформе используется серверный вызов формы через ПолучитьФорму()
	ЭлементыФормы.Очистить();
	
	Попытка
		Форма = ПолучитьФорму(ИмяФормы, , , Ложь, Ложь, Ложь);
		
		Для Каждого Элемент Из Форма.Элементы Цикл
			НоваяСтрока = ЭлементыФормы.Добавить();
			НоваяСтрока.Имя    = Элемент.Имя;
			НоваяСтрока.Тип    = "" + ТипЗнч(Элемент);
		КонецЦикла;
		
	Исключение
		ПоказатьОтладочнуюИнформацию = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецПроцедуры
