// Модуль формы Консоли СКД

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ИнициализироватьСКД();
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура Выполнить(Команда)
	Попытка
		ВыполнитьСКДНаСервере();
		СтрокаСтатуса = "Схема выполнена успешно.";
	Исключение
		СтрокаСтатуса = "Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура КонструкторСхемы(Команда)
	ПоказатьПредупреждение(, "Конструктор схемы компоновки данных открывается через платформу (встроенный редактор схемы).");
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ИнициализироватьСКД()
	// Создать пустую схему СКД для начала работы
	Схема = Новый СхемаКомпоновкиДанных;
	НаборДанных = Схема.НаборыДанных.Добавить(Тип("НаборДанныхЗапросаСхемыКомпоновкиДанных"));
	НаборДанных.Запрос = "ВЫБРАТЬ 1 КАК Поле1";
	ЗначениеВРеквизитФормы(Схема, "СхемаСКД");
КонецПроцедуры

&НаСервере
Процедура ВыполнитьСКДНаСервере()
	Схема = РеквизитФормыВЗначение("СхемаСКД");
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	КомпоновщикНастроек.ЗаполнитьНастройки();
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, КомпоновщикНастроек.Настройки, ,
		Новый ГенераторМакетаКомпоновкиДанных);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет);
	
	ВыводРезультата = Новый ПроцессорВыводаРезультатаКомпоновкиДанных;
	ТабДок = Новый ТабличныйДокумент;
	ВыводРезультата.УстановитьДокумент(ТабДок);
	ВыводРезультата.Вывести(ПроцессорКомпоновки);
	
	// Сохранить результат для отображения
	РезультатСКД = ТабДок;
КонецПроцедуры
