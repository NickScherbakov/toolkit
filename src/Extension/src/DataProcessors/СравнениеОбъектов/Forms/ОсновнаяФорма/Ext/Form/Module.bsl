// Модуль формы Сравнения объектов

#Область КомандыФормы

&НаКлиенте
Процедура Сравнить(Команда)
	Если НЕ ЗначениеЗаполнено(Ссылка1) ИЛИ НЕ ЗначениеЗаполнено(Ссылка2) Тогда
		ПоказатьПредупреждение(, "Укажите обе ссылки для сравнения.");
		Возврат;
	КонецЕсли;
	СравнитьОбъектыНаСервере();
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура СравнитьОбъектыНаСервере()
	РезультатСравнения.Очистить();
	
	Если Ссылка1.Метаданные() <> Ссылка2.Метаданные() Тогда
		ПоказатьОтличия = "Объекты разных типов: " + Ссылка1.Метаданные().ПолноеИмя()
			+ " и " + Ссылка2.Метаданные().ПолноеИмя();
		Возврат;
	КонецЕсли;
	
	Объект1 = Ссылка1.ПолучитьОбъект();
	Объект2 = Ссылка2.ПолучитьОбъект();
	МД = Ссылка1.Метаданные();
	
	Для Каждого Реквизит Из МД.Реквизиты Цикл
		Знач1 = Объект1[Реквизит.Имя];
		Знач2 = Объект2[Реквизит.Имя];
		Если Знач1 <> Знач2 Тогда
			НоваяСтрока = РезультатСравнения.Добавить();
			НоваяСтрока.Реквизит  = Реквизит.Имя;
			НоваяСтрока.Значение1 = Строка(Знач1);
			НоваяСтрока.Значение2 = Строка(Знач2);
			НоваяСтрока.Отличие   = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
