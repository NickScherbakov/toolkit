// Модуль формы инструмента "Пользователи"

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьСписокПользователей();
КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьСписокПользователей();
КонецПроцедуры

&НаКлиенте
Процедура ЗаблокироватьПользователя(Команда)
	ТекущаяСтрока = Элементы.ТаблицаПользователей.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда Возврат; КонецЕсли;
	Попытка
		УстановитьЗаблокированностьПользователяНаСервере(ТекущаяСтрока.ИмяПользователя, Истина);
		ОбновитьСписокПользователей();
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура РазблокироватьПользователя(Команда)
	ТекущаяСтрока = Элементы.ТаблицаПользователей.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда Возврат; КонецЕсли;
	Попытка
		УстановитьЗаблокированностьПользователяНаСервере(ТекущаяСтрока.ИмяПользователя, Ложь);
		ОбновитьСписокПользователей();
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ОбновитьСписокПользователей()
	ТаблицаПользователей.Очистить();
	ПользователиИБ = ИнформационнаяБаза.ПолучитьПользователей();
	Для Каждого Польз Из ПользователиИБ Цикл
		НоваяСтрока = ТаблицаПользователей.Добавить();
		НоваяСтрока.ИмяПользователя = Польз.Имя;
		НоваяСтрока.ПолноеИмя       = Польз.ПолноеИмя;
		НоваяСтрока.Заблокирован    = Польз.Заблокирован;
		НоваяСтрока.КоличествоРолей = Польз.Роли.Количество();
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаблокированностьПользователяНаСервере(ИмяПользователя, Заблокирован)
	Польз = ИнформационнаяБаза.НайтиПользователяПоИмени(ИмяПользователя);
	Если Польз = Неопределено Тогда
		ВызватьИсключение "Пользователь не найден: " + ИмяПользователя;
	КонецЕсли;
	Польз.Заблокирован = Заблокирован;
	Польз.Записать();
КонецПроцедуры
