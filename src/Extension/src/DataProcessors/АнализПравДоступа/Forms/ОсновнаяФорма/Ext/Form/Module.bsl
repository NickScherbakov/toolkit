// Модуль формы Анализа прав доступа

#Область КомандыФормы

&НаКлиенте
Процедура Анализировать(Команда)
	АнализироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПраво(Команда)
	Если ПустаяСтрока(ПолноеИмяОбъекта) ИЛИ ПустаяСтрока(ИмяПрава) Тогда
		ПоказатьПредупреждение(, "Укажите объект и право для проверки.");
		Возврат;
	КонецЕсли;
	ПроверитьПравоНаСервере();
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура АнализироватьНаСервере()
	МатрицаПрав.Очистить();
	ПользователиИБ = ИнформационнаяБаза.ПолучитьПользователей();
	Для Каждого Польз Из ПользователиИБ Цикл
		Для Каждого Роль Из Польз.Роли Цикл
			НоваяСтрока = МатрицаПрав.Добавить();
			НоваяСтрока.Пользователь = Польз.ПолноеИмя;
			НоваяСтрока.Роль         = Роль.Имя;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПроверитьПравоНаСервере()
	МД = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	Если МД = Неопределено Тогда
		РезультатПроверки = "Объект метаданных не найден: " + ПолноеИмяОбъекта;
		Возврат;
	КонецЕсли;
	ЕстьПраво = ПравоДоступа(ИмяПрава, МД);
	РезультатПроверки = ?(ЕстьПраво,
		"Доступ РАЗРЕШЁН: " + ИмяПрава + " на " + ПолноеИмяОбъекта,
		"Доступ ЗАПРЕЩЁН: " + ИмяПрава + " на " + ПолноеИмяОбъекта);
КонецПроцедуры
