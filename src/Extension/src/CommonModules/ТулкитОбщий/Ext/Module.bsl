// Общий серверный модуль Toolkit
// Содержит вспомогательные процедуры и функции, используемые всеми инструментами

// Возвращает строковое представление произвольного значения для отображения в интерфейсе.
// Параметры:
//   Значение — Произвольный — значение для преобразования
// Возвращаемое значение: Строка
Функция ПредставлениеЗначения(Значение) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат "<Неопределено>";
	ИначеЕсли Значение = NULL Тогда
		Возврат "<NULL>";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='дд.ММ.гггг чч:мм:сс'");
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	Иначе
		Возврат Строка(Значение);
	КонецЕсли;
	
КонецФункции

// Возвращает метаданные объекта по его ссылке.
// Параметры:
//   Ссылка — ЛюбаяСсылка — ссылка на объект
// Возвращаемое значение: ОбъектМетаданных или Неопределено
Функция МетаданныеОбъекта(Ссылка) Экспорт
	
	Если Ссылка = Неопределено ИЛИ Ссылка = NULL Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Ссылка.Метаданные();
	
КонецФункции

// Возвращает тип метаданных в виде строки (Справочник, Документ, и т.д.).
// Параметры:
//   МетаданныеОбъекта — ОбъектМетаданных
// Возвращаемое значение: Строка
Функция ТипМетаданных(МетаданныеОбъекта) Экспорт
	
	Если Метаданные.Справочники.Содержит(МетаданныеОбъекта) Тогда
		Возврат "Справочник";
	ИначеЕсли Метаданные.Документы.Содержит(МетаданныеОбъекта) Тогда
		Возврат "Документ";
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(МетаданныеОбъекта) Тогда
		Возврат "РегистрСведений";
	ИначеЕсли Метаданные.РегистрыНакопления.Содержит(МетаданныеОбъекта) Тогда
		Возврат "РегистрНакопления";
	ИначеЕсли Метаданные.РегистрыБухгалтерии.Содержит(МетаданныеОбъекта) Тогда
		Возврат "РегистрБухгалтерии";
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(МетаданныеОбъекта) Тогда
		Возврат "ПланВидовХарактеристик";
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(МетаданныеОбъекта) Тогда
		Возврат "ПланСчетов";
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(МетаданныеОбъекта) Тогда
		Возврат "ПланВидовРасчета";
	ИначеЕсли Метаданные.БизнесПроцессы.Содержит(МетаданныеОбъекта) Тогда
		Возврат "БизнесПроцесс";
	ИначеЕсли Метаданные.Задачи.Содержит(МетаданныеОбъекта) Тогда
		Возврат "Задача";
	ИначеЕсли Метаданные.Перечисления.Содержит(МетаданныеОбъекта) Тогда
		Возврат "Перечисление";
	Иначе
		Возврат "Неизвестно";
	КонецЕсли;
	
КонецФункции

// Проверяет наличие у текущего пользователя доступа к указанному праву объекта метаданных.
// Параметры:
//   МетаданныеОбъекта — ОбъектМетаданных
//   ИмяПрава          — Строка — например "Чтение", "Изменение"
// Возвращаемое значение: Булево
Функция ПравоДоступа(МетаданныеОбъекта, ИмяПрава) Экспорт
	
	Попытка
		Возврат ПравоДоступа(ИмяПрава, МетаданныеОбъекта);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// Формирует таблицу значений из результата запроса.
// Параметры:
//   РезультатЗапроса — РезультатЗапроса
// Возвращаемое значение: ТаблицаЗначений
Функция РезультатЗапросаВТаблицу(РезультатЗапроса) Экспорт
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции
