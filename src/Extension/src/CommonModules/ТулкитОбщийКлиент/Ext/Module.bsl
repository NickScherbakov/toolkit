// Общий клиентский модуль Toolkit
// Содержит клиентские вспомогательные процедуры

// Открывает указанный инструмент Toolkit в новом окне.
// Параметры:
//   ИмяОбработки — Строка — имя обработки, например "КонсольЗапросов"
Процедура ОткрытьИнструмент(ИмяОбработки) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ОткрытьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма.ОсновнаяФорма", ПараметрыФормы,, Истина);
	
КонецПроцедуры

// Отображает сообщение об ошибке пользователю.
// Параметры:
//   ТекстОшибки — Строка
Процедура ПоказатьОшибку(ТекстОшибки) Экспорт
	
	ПоказатьПредупреждение(, "Ошибка: " + ТекстОшибки, , "1C Developer Toolkit");
	
КонецПроцедуры

// Возвращает текущую версию расширения.
// Возвращаемое значение: Строка
Функция ВерсияРасширения() Экспорт
	
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Если Расширение.Имя = "1CDeveloperToolkit" Тогда
			Возврат Расширение.Версия;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "0.0.0";
	
КонецФункции
