  "improvements": [
    {
      "id": "catalog-as-source-of-truth",
      "priority": "high",
      "title": "Сделать каталог инструментов единственным поддерживаемым источником истины",
      "rationale": "Сегодня перечень инструментов и ссылки размазаны по README, вспомогательным markdown и бинарной документации. Машиночитаемый каталог снижает вероятность расхождений и упрощает автоматические проверки."
    },
    {
      "id": "document-source-code-gap",
      "priority": "high",
      "title": "Явно зафиксировать отсутствие публичных исходников как блокер для продуктовых изменений",
      "rationale": "README уже сообщает, что исходники не хранятся в репозитории. Эту проблему нужно поднимать как критический блокер, чтобы не обещать недоступную реализацию в публичном PR."
    },
    {
      "id": "ci-validation",
      "priority": "high",
      "title": "Автоматизировать проверку каталога и документации в CI",
      "rationale": "В репозитории отсутствуют штатные проверки. Базовая валидация структуры и тестов предотвращает регрессии в ссылках, ролях и описаниях."
    },
    {
      "id": "issue-intake",
      "priority": "medium",
      "title": "Улучшить шаблоны bug/feature issues полями приоритета, риска и артефактов",
      "rationale": "Сейчас шаблоны не собирают severity, ожидаемые артефакты и влияние на пользователей, что усложняет triage и коммуникацию."
    },
    {
      "id": "upgrade-and-migration-docs",
      "priority": "medium",
      "title": "Выделить обновление и миграцию в отдельные документы",
      "rationale": "Инструкции по установке и обновлению разбросаны между README, docx/pdf и auto_install.md. Отдельный migration pack делает поддержку предсказуемой."
    },
    {
      "id": "security-observability-docs",
      "priority": "medium",
      "title": "Отдельно описать зависимости, риски безопасности и требования к артефактам",
      "rationale": "Документ с библиотеками и сервисами очень краткий; для поддерживаемости полезно фиксировать внешние интеграции, риски и срок хранения артефактов."
    },
    {
      "id": "binary-doc-replacement",
      "priority": "low",
      "title": "Постепенно заменять бинарную документацию markdown-версиями",
      "rationale": "Docx/pdf плохо поддаются ревью, diff и автоматическим проверкам. Markdown-аналоги проще поддерживать в PR-потоке."
    }
  ],
  "critical_blockers": [
    {
      "id": "private-product-source",
      "title": "Публичный репозиторий не содержит исходный код продукта",
      "severity": "critical",
      "rationale": "Невозможно реализовать или протестировать продуктовые изменения Toolkit без доступа к закрытым исходникам, тестам и внутренним CI."
    }
  ]
}
